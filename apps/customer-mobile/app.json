{
  "expo": {
    "name": "Floria",
    "slug": "floria-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "floria",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.floria.customer"
    },
    "android": {
      "package": "com.floria.customer"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FBF8F3",
      "translucent": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}

{
  "expo": {
    "name": "Floria",
    "slug": "floria-customer",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F8F3"
    },
    "orientation": "portrait",
    "scheme": "floria",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.floria.customer"
    },
    "android": {
      "package": "com.floria.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F8F3"
      }
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FBF8F3",
      "translucent": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1C3524",
          "sounds": ["./assets/sounds/floria_chime.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

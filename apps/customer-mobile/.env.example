# ==================================================
# Floria Customer Mobile — Environment Variables
# ==================================================
# Copy to .env.local and fill in values.
# NEVER commit .env.local with real credentials.
# ==================================================

# API base URL — points to @floria/api (Express backend)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Supabase — public (safe for mobile bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# DO NOT ADD:
# SUPABASE_SERVICE_ROLE_KEY  — server-only, never in mobile clients
# CASHFREE_CLIENT_SECRET     — server-only, stays in @floria/api
# DATABASE_URL               — server-only, stays in @floria/api
# REDIS_URL                  — server-only, stays in @floria/api

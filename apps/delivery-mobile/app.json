{
  "expo": {
    "name": "Floria Delivery",
    "slug": "floria-delivery",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F8F3"
    },
    "orientation": "portrait",
    "scheme": "floria-delivery",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.floria.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Floria Delivery needs your location to navigate to pickup and delivery addresses.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Floria Delivery needs your location in the background to track active deliveries.",
        "NSCameraUsageDescription": "Floria Delivery uses the camera to capture proof of delivery photos."
      }
    },
    "android": {
      "package": "com.floria.delivery",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F8F3"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}

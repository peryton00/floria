{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@floria/types": [
        "../../packages/types/src/index.ts"
      ],
      "@floria/validation": [
        "../../packages/validation/src/index.ts"
      ],
      "@floria/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@floria/icons": [
        "../../packages/icons/src/index.ts"
      ],
      "@floria/icons/native": [
        "../../packages/icons/src/native/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

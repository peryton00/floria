apps/web/.next/
apps/web/out/

# Turbo cache
.turbo/

# Vercel
.vercel/

# Testing
coverage/
playwright-report/
test-results/

# pnpm lock (committed), pnpm store
# pnpm-lock.yaml is intentionally tracked


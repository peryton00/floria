# ==================================================
# Floria — Root Environment Variables Reference
# ==================================================
# This file documents which variables belong to which application.
# Copy the relevant .env.example from the specific app/backend directory.
# NEVER commit real credentials.
# ==================================================

# --------------------------------------------------
# @floria/api (backend/api/.env)     — SERVER ONLY
# --------------------------------------------------
# PORT=4000
# NODE_ENV=development
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   ← NEVER expose to clients
# DATABASE_URL=postgresql://...                           ← NEVER expose to clients
# REDIS_URL=your_redis_url                               ← NEVER expose to clients
# CASHFREE_CLIENT_ID=your_cashfree_client_id             ← NEVER expose to clients
# CASHFREE_CLIENT_SECRET=your_cashfree_client_secret     ← NEVER expose to clients
# CASHFREE_ENVIRONMENT=SANDBOX
# CASHFREE_API_VERSION=2023-08-01
# CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret   ← NEVER expose to clients

# --------------------------------------------------
# @floria/web (apps/web/.env.local)  — PUBLIC + SERVER (Next.js)
# --------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NODE_ENV=development

# --------------------------------------------------
# @floria/seller-web (apps/seller-web/.env.local)
# @floria/admin-web  (apps/admin-web/.env.local)
# --------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# NEXT_PUBLIC_APP_URL=http://localhost:3001  (seller) / 3002 (admin)

# --------------------------------------------------
# Mobile apps (apps/*/env.local) — EXPO_PUBLIC_ prefix
# --------------------------------------------------
# EXPO_PUBLIC_API_URL=http://localhost:4000
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ==================================================
# SECURITY INVARIANTS
# ==================================================
# The following must NEVER appear in any web or mobile client bundle:
#   SUPABASE_SERVICE_ROLE_KEY
#   CASHFREE_CLIENT_SECRET
#   CASHFREE_WEBHOOK_SECRET
#   DATABASE_URL
#   REDIS_URL

# ==================================================
# Floria — Environment Variables
# ==================================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local or any file with real credentials.
# ==================================================

# --------------------------------------------------
# Supabase — required for all features
# --------------------------------------------------

# Public (safe to expose in browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --------------------------------------------------
# Razorpay — required for payment features (deferred)
# --------------------------------------------------

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# Public Razorpay key used in browser checkout UI
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# --------------------------------------------------
# Application
# --------------------------------------------------

# Canonical URL — used for webhook callbacks and OG tags
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development
